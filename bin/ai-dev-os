#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
AI_DEV_OS_HOME="$(CDPATH= cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd || true)"

find_source_dir() {
  if [ -f "$SCRIPT_DIR/../install.sh" ]; then
    CDPATH= cd -- "$SCRIPT_DIR/.." && pwd
    return
  fi

  manifest="$AI_DEV_OS_HOME/manifest.json"
  if [ -f "$manifest" ]; then
    source_dir="$(sed -n 's/.*"installed_from"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -n 1)"
    if [ -n "$source_dir" ] && [ -f "$source_dir/install.sh" ]; then
      printf '%s\n' "$source_dir"
      return
    fi
  fi

  echo "STOP cannot locate AI Dev OS source install.sh" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: ai-dev-os <command> [path]

Commands:
  init [options] [path]
                   Install .ai-dev project files into path, default .
                   Options: --profile <name>, --detect
  attach [options] [path]
                   Alias for init
  check [path]     Check required .ai-dev files, default .
  doctor [path]    Check global install and project health, default .
  version          Print installed version
  help             Show this help
EOF
}

parse_init_args() {
  INIT_TARGET="."
  INIT_PROFILE=""
  INIT_DETECT=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --profile)
        shift
        if [ "$#" -eq 0 ] || [ -z "$1" ]; then
          echo "STOP --profile requires a value" >&2
          exit 1
        fi
        INIT_PROFILE="$1"
        ;;
      --detect)
        INIT_DETECT=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --)
        shift
        if [ "$#" -gt 0 ]; then
          INIT_TARGET="$1"
        fi
        ;;
      -*)
        echo "STOP unknown init option: $1" >&2
        exit 1
        ;;
      *)
        INIT_TARGET="$1"
        ;;
    esac
    shift || true
  done
}

write_cli_profile() {
  target="$1"
  profile="$2"
  detect="$3"

  if [ -z "$profile" ] && [ "$detect" -ne 1 ]; then
    return
  fi

  ai_dev_dir="$target/.ai-dev"
  if [ ! -d "$ai_dev_dir" ]; then
    echo "STOP missing $ai_dev_dir after init" >&2
    exit 1
  fi

  branch="$(git -C "$target" branch --show-current 2>/dev/null || true)"
  remote="$(git -C "$target" remote get-url origin 2>/dev/null || true)"

  {
    echo "# AI Dev OS CLI Profile"
    echo
    echo "- Profile: ${profile:-default}"
    echo "- Detect requested: $detect"
    echo "- Git branch: ${branch:-unknown}"
    echo "- Git remote: ${remote:-none}"
  } > "$ai_dev_dir/CLI_PROFILE.md"

  echo "create $ai_dev_dir/CLI_PROFILE.md"
}

cmd="${1:-help}"
case "$cmd" in
  -h|--help|help)
    usage
    ;;
  version|--version)
    if [ -f "$AI_DEV_OS_HOME/VERSION" ]; then
      cat "$AI_DEV_OS_HOME/VERSION"
    else
      git -C "$(find_source_dir)" rev-parse --short HEAD 2>/dev/null || echo "unknown"
    fi
    ;;
  init|attach)
    shift || true
    parse_init_args "$@"
    source_dir="$(find_source_dir)"
    "$source_dir/install.sh" --project "$INIT_TARGET"
    write_cli_profile "$INIT_TARGET" "$INIT_PROFILE" "$INIT_DETECT"
    ;;
  check)
    shift || true
    target="${1:-.}"
    if [ -x "$AI_DEV_OS_HOME/bin/ai-dev-os-check.sh" ]; then
      "$AI_DEV_OS_HOME/bin/ai-dev-os-check.sh" "$target"
    else
      source_dir="$(find_source_dir)"
      "$source_dir/scripts/ai-dev-os-check.sh" "$target"
    fi
    ;;
  doctor)
    shift || true
    target="${1:-.}"
    warn=0

    if [ -d "$AI_DEV_OS_HOME" ]; then
      echo "PASS ai-dev-os home=$AI_DEV_OS_HOME"
    else
      echo "WARN ai-dev-os home not found: $AI_DEV_OS_HOME"
      warn=1
    fi

    if [ -f "$AI_DEV_OS_HOME/manifest.json" ]; then
      echo "PASS manifest=$AI_DEV_OS_HOME/manifest.json"
    else
      echo "WARN manifest missing"
      warn=1
    fi

    if [ -f "$HOME/.codex/AGENTS.md" ]; then
      echo "PASS codex agents=$HOME/.codex/AGENTS.md"
    else
      echo "WARN codex agents missing"
      warn=1
    fi

    if [ -x "$SCRIPT_DIR/ai-dev-os" ]; then
      echo "PASS cli=$SCRIPT_DIR/ai-dev-os"
    else
      echo "WARN cli script is not executable"
      warn=1
    fi

    if [ -d "$target" ]; then
      echo "PASS target=$target"
    else
      echo "STOP target not found: $target"
      exit 1
    fi

    if [ ! -d "$target/.ai-dev" ]; then
      echo "WARN project check skipped: target has no .ai-dev; run init explicitly when this is a project"
      echo "SUMMARY WARN"
      exit 0
    fi

    check_output="$("$0" check "$target" 2>&1)" || {
      printf '%s\n' "$check_output" | sed '/^SUMMARY /d'
      echo "SUMMARY STOP"
      exit 1
    }
    printf '%s\n' "$check_output" | sed '/^SUMMARY /d'
    if printf '%s\n' "$check_output" | grep -q "SUMMARY WARN"; then
      warn=1
    fi

    if [ "$warn" -eq 1 ]; then
      echo "SUMMARY WARN"
    else
      echo "SUMMARY PASS"
    fi
    ;;
  *)
    echo "STOP unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
